# Copie para .env.homolog e gere um valor distinto para cada segredo.
# Exemplo de geração por campo: openssl rand -hex 32
HOMOLOG_PORT=18080
HOMOLOG_ORIGIN=https://easypet.innker.com.br
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://easypet.innker.com.br/api/v1/login/oauth2/code/google
GOOGLE_ALLOWED_EMAILS=
# Set an exact IP of the HTTPS reverse proxy after checking the route to the frontend.
HOMOLOG_TRUSTED_EDGE=unix:
HOMOLOG_SUPPORT_URL=
HOMOLOG_INGRESS_TOKEN=
JWT_SECRET=
AUTH_DB_PASSWORD=
PET_DB_PASSWORD=
PARTNER_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
AUTH_TEAM_JWT_SECRET=
BOOKING_OUTBOX_TOKEN=
NOTIFICATION_RECIPIENT_TOKEN=
RECEPTION_CLAIM_TOKEN=
BOOKING_PET_SUMMARY_TOKEN=
