# =============================================================
# Easypet — Variáveis de Ambiente da Infraestrutura
# =============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env.
# =============================================================

# ─── Auth DB ─────────────────────────────────────────────────
AUTH_DB_USERNAME=admin
AUTH_DB_PASSWORD=troque_esta_senha

# ─── Pet DB ──────────────────────────────────────────────────
PET_DB_USERNAME=admin
PET_DB_PASSWORD=troque_esta_senha

# ─── Partner DB ──────────────────────────────────────────────
PARTNER_DB_USERNAME=admin
PARTNER_DB_PASSWORD=troque_esta_senha

# ─── Booking DB ──────────────────────────────────────────────
BOOKING_DB_USERNAME=admin
BOOKING_DB_PASSWORD=troque_esta_senha

# ─── Payment DB ──────────────────────────────────────────────
PAYMENT_DB_USERNAME=admin
PAYMENT_DB_PASSWORD=troque_esta_senha

# ─── Redis ───────────────────────────────────────────────────
# Sem autenticação por padrão — configure senha em produção

# ─── MinIO ───────────────────────────────────────────────────
MINIO_USER=admin
MINIO_PASSWORD=troque_esta_senha

# ─── PgAdmin ─────────────────────────────────────────────────
PGADMIN_EMAIL=admin@easypet.com
PGADMIN_PASSWORD=troque_esta_senha
